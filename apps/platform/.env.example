APP_NAME="AI Store Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker Compose, DB_HOST/REDIS_HOST are overridden to the service names.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=aisg
DB_USERNAME=aisg
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AI (docs/ARCHITECTURE.md §5) ----
AI_DRIVER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=180
# Context window. 4096 keeps qwen3:4b (mostly) on a 4 GB GPU; prompts here are < 1.5k tokens.
OLLAMA_NUM_CTX=4096
# Sized for a 4 GB GPU. Benchmarked and possibly changed in M2.
AI_MODEL_PLANNER=qwen3:4b
AI_MODEL_COPY=qwen3:4b
AI_MODEL_VISION=qwen2.5vl:3b

# ---- Credits (docs/ARCHITECTURE.md §2.4) ----
# Credits granted to a new user's personal team. Keep 0 in production once billing exists.
CREDITS_SIGNUP_GRANT=100

# ---- Realtime (Laravel Reverb) ----
# Inside Docker, REVERB_HOST is overridden to "reverb" for server-side publishing;
# the browser connects through VITE_REVERB_HOST.
REVERB_APP_ID=aisg
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8090
VITE_REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"

# ---- WordPress connector (M4) ----
# URL the WordPress plugin uses to reach this platform (API + media downloads).
# In Docker dev the staging WordPress reaches the platform through nginx.
CONNECTOR_PLATFORM_URL=http://nginx
# Dev only: the staging site calls itself http://localhost:8081, the platform reaches it as http://wp.
CONNECTOR_SITE_URL_REWRITES=http://localhost:8081=http://wp
