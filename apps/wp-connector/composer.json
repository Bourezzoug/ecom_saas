{
    "name": "aisg/wp-connector",
    "description": "AISG Connector WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "mustache/mustache": "^2.14 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Aisg\\Connector\\": "src/",
            "Aisg\\Sections\\": "lib/renderer-php/src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true
    }
}
