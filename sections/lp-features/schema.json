{
    "$schema": "../_meta-schema/section.schema.json",
    "key": "lp-features",
    "version": 1,
    "fields": [
        {
            "name": "title",
            "type": "text",
            "label": "Title",
            "default": "Designed around you",
            "constraints": {
                "maxLength": 70,
                "minLength": 2
            },
            "required": true,
            "ai": {
                "generate": true,
                "hint": "Short section title"
            }
        },
        {
            "name": "items",
            "type": "repeater",
            "label": "Features",
            "item_label": "{{title}}",
            "constraints": {
                "minItems": 2,
                "maxItems": 4
            },
            "default": [
                {
                    "title": "Thoughtful design",
                    "text": "Every detail has a purpose.",
                    "image": {
                        "asset_id": null,
                        "url": null,
                        "alt": ""
                    }
                },
                {
                    "title": "Built to last",
                    "text": "Quality materials that stand the test of time.",
                    "image": {
                        "asset_id": null,
                        "url": null,
                        "alt": ""
                    }
                }
            ],
            "ai": {
                "generate": true,
                "hint": "Distinct product features with a concrete explanation each"
            },
            "fields": [
                {
                    "name": "title",
                    "type": "text",
                    "label": "Title",
                    "default": "",
                    "constraints": {
                        "maxLength": 60,
                        "minLength": 2
                    },
                    "ai": {
                        "generate": true,
                        "hint": "2 to 6 words"
                    }
                },
                {
                    "name": "text",
                    "type": "textarea",
                    "label": "Text",
                    "default": "",
                    "constraints": {
                        "maxLength": 300
                    },
                    "ai": {
                        "generate": true,
                        "hint": "Two sentences explaining the feature and its benefit"
                    }
                },
                {
                    "name": "image",
                    "type": "image",
                    "label": "Image",
                    "default": {
                        "asset_id": null,
                        "url": null,
                        "alt": ""
                    }
                }
            ]
        }
    ],
    "style": [
        {
            "name": "background",
            "type": "select",
            "label": "Background",
            "default": "background",
            "options": [
                {
                    "value": "background",
                    "label": "Page background"
                },
                {
                    "value": "surface",
                    "label": "Surface"
                }
            ]
        }
    ],
    "data": {}
}
