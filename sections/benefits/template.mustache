<section id="{{section.anchor}}" data-aisg-section="{{section.key}}" class="aisg-benefits tw-py-section {{#style.background_is_background}}tw-bg-background tw-text-text{{/style.background_is_background}}{{#style.background_is_surface}}tw-bg-surface tw-text-text{{/style.background_is_surface}}">
    <div class="tw-mx-auto tw-max-w-container tw-px-4">
        <div class="tw-mx-auto tw-mb-10 tw-max-w-2xl tw-text-center">
            {{#content.eyebrow}}<p class="tw-mb-2 tw-text-sm tw-font-semibold tw-uppercase tw-tracking-wider tw-text-primary">{{content.eyebrow}}</p>{{/content.eyebrow}}
            <h2 class="tw-font-heading tw-text-3xl tw-font-bold">{{content.title}}</h2>
        </div>
        <ul class="tw-grid tw-gap-8 sm:tw-grid-cols-2 {{#style.columns_is_3}}lg:tw-grid-cols-3{{/style.columns_is_3}}{{#style.columns_is_4}}lg:tw-grid-cols-4{{/style.columns_is_4}}">
            {{#content.items}}
            <li class="tw-flex tw-flex-col tw-items-center tw-gap-3 tw-text-center">
                <span class="tw-flex tw-h-12 tw-w-12 tw-items-center tw-justify-center tw-rounded-full tw-bg-primary tw-text-primary-contrast"><span class="aisg-icon aisg-icon--{{icon}}" aria-hidden="true"></span></span>
                <h3 class="tw-font-heading tw-text-lg tw-font-semibold">{{title}}</h3>
                <p class="tw-text-sm tw-text-muted">{{text}}</p>
            </li>
            {{/content.items}}
        </ul>
    </div>
</section>
