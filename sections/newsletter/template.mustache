<section id="{{section.anchor}}" data-aisg-section="{{section.key}}" class="aisg-newsletter tw-py-section {{#style.background_is_background}}tw-bg-background tw-text-text{{/style.background_is_background}}{{#style.background_is_surface}}tw-bg-surface tw-text-text{{/style.background_is_surface}}{{#style.background_is_primary}}tw-bg-primary tw-text-primary-contrast{{/style.background_is_primary}}">
    <div class="tw-mx-auto tw-flex tw-max-w-2xl tw-flex-col tw-items-center tw-gap-4 tw-px-4 tw-text-center">
        <h2 class="tw-font-heading tw-text-3xl tw-font-bold">{{content.title}}</h2>
        {{#content.text}}<p class="tw-opacity-80">{{content.text}}</p>{{/content.text}}
        <form action="{{content.form_target.href}}" method="post" class="tw-mt-2 tw-flex tw-w-full tw-max-w-md tw-flex-col tw-gap-3 sm:tw-flex-row">
            <label class="tw-sr-only" for="{{section.anchor}}-email">{{content.placeholder}}</label>
            <input id="{{section.anchor}}-email" type="email" name="email" required placeholder="{{content.placeholder}}" class="tw-min-w-0 tw-flex-1 tw-rounded-aisg tw-border tw-border-border tw-bg-background tw-px-4 tw-py-3 tw-text-text">
            <button type="submit" class="tw-rounded-aisg tw-px-6 tw-py-3 tw-font-semibold {{^style.background_is_primary}}tw-bg-primary tw-text-primary-contrast{{/style.background_is_primary}}{{#style.background_is_primary}}tw-bg-primary-contrast tw-text-primary{{/style.background_is_primary}}">{{content.button_label}}</button>
        </form>
        {{#content.consent}}<p class="tw-text-xs tw-opacity-70">{{content.consent}}</p>{{/content.consent}}
    </div>
</section>
